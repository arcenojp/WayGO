# Copy this file to .env and fill it in. .env is never committed.

# --- Server ---
PORT=4000
# development or production. Production requires HTTPS cookies and SMTP.
NODE_ENV=development

# Frontend address(es) allowed to call the API, comma-separated.
# Only needed when the frontend calls the backend directly (local development).
FRONTEND_ORIGINS=http://localhost:5173

# --- Database ---
# Matches `npm run db:local`. On a host, use the URL your database provider gives you.
DATABASE_URL=postgres://postgres:waygo-local@localhost:5433/waygo
# Set to true for hosted databases that require SSL (Neon, Render, Supabase).
DATABASE_SSL=false

# --- Sessions ---
SESSION_DAYS=7
# lax works when the frontend proxies /api to the backend (recommended).
# Use none only if the browser calls the backend on a different site.
COOKIE_SAMESITE=lax

# --- Email (verification and password-reset codes) ---
# Leave SMTP_HOST empty in development: codes are printed in the server log.
# Gmail: smtp.gmail.com, port 465, your address, and an App Password.
# Resend: smtp.resend.com, port 465, user "resend", your API key.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=WayGo <no-reply@example.com>

# Behind a host's proxy (Render, Railway), set to 1 so rate limits see real IPs.
TRUST_PROXY=0
