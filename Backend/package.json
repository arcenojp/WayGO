{
  "name": "waygo-backend",
  "version": "1.0.0",
  "private": true,
  "description": "WayGo backend: login, registration with allowlist and email codes, and admin API",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "db:local": "node --env-file-if-exists=.env scripts/local-db.js",
    "test": "node --test --test-timeout=60000 \"test/**/*.test.js\""
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17"
  }
}
