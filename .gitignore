# Applies to the whole repo; campus-map-app/ and Backend/ add their own rules.

# Installed packages and build output
node_modules/
dist/

# Secrets: never commit these. Only the .env.example files are shared.
.env
.env.*
!.env.example

# Local development database (Backend: npm run db:local)
.local-db/

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log
